{
  "name": "knowy",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm --filter @knowy/core build && pnpm -r exec tsc --noEmit && tsc -p tsconfig.test.json",
    "example": "pnpm -r build && node --experimental-strip-types examples/cold-to-warm.ts",
    "calibrate": "pnpm -r build && node --experimental-strip-types calibration/run.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.7.0",
    "@knowy/core": "workspace:*",
    "@knowy/index-memory": "workspace:*",
    "@knowy/store-memory": "workspace:*",
    "@knowy/embed-local": "workspace:*"
  }
}
